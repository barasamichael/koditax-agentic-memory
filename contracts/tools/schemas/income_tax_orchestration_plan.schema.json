{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncomeTaxOrchestrationPlan",
  "description": "Deterministic orchestration plan for supported Phase 6 income-tax prompt intents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "intent_class",
    "supported_lane_id",
    "historical_version_id",
    "tax_year",
    "steps",
    "plan_status",
    "correlation_id",
    "trace_id"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent_class": {
      "const": "compute_income_tax"
    },
    "supported_lane_id": {
      "type": "string",
      "minLength": 1
    },
    "historical_version_id": {
      "type": "string",
      "pattern": "^KIT-VER-\\d{8}-A$"
    },
    "tax_year": {
      "type": "integer",
      "minimum": 2004,
      "maximum": 2100
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/OrchestrationStep"
      }
    },
    "plan_status": {
      "const": "planned"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "OrchestrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_order",
        "step_id",
        "step_type",
        "module_ref",
        "action_ref",
        "external_action"
      ],
      "properties": {
        "step_order": {
          "type": "integer",
          "minimum": 1
        },
        "step_id": {
          "type": "string",
          "enum": [
            "capability_check",
            "income_tax_computation",
            "form_mapping",
            "form_version_binding",
            "form_artifact_generation",
            "report_generation",
            "report_version_binding",
            "submission_payload_construction",
            "submission_workflow_initialize",
            "submission_workflow_ready_transition",
            "submission_workflow_internal_submit_transition",
            "submission_closure"
          ]
        },
        "step_type": {
          "type": "string",
          "enum": [
            "guardrail",
            "computation",
            "forms",
            "reporting",
            "submission"
          ]
        },
        "module_ref": {
          "type": "string",
          "minLength": 1
        },
        "action_ref": {
          "type": "string",
          "minLength": 1
        },
        "external_action": {
          "const": false
        }
      }
    }
  }
}
